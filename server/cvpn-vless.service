[Unit]
Description=cvpn: VLESS (sing-box tun)
After=network-online.target
Wants=network-online.target

[Service]
ExecStartPre=/usr/local/lib/cvpn/cvpn _rules up
ExecStart=/usr/bin/sing-box run -c /usr/local/etc/cvpn/singbox.json
ExecStopPost=/usr/local/lib/cvpn/cvpn _rules down
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
